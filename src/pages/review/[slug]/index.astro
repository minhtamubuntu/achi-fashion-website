---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const items = await getCollection('reviews', ({ data }) => !data.draft);
  return items.map(item => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
---
<BaseLayout title={`${item.data.title} | ACHI FASHION`} description={item.data.description}>
<article class="review">
  <a href="/review/">← Tất cả review</a>
  <p class="kicker">PRODUCT REVIEW</p><h1>{item.data.title}</h1><p class="lead">{item.data.description}</p>
  {item.data.cover && <img class="cover" src={item.data.cover} alt={item.data.productName} />}
  <div class="columns">
    <section><h2>Điểm đáng chú ý</h2><ul>{item.data.pros.map(x => <li>{x}</li>)}</ul></section>
    <section><h2>Lưu ý</h2><ul>{item.data.cons.map(x => <li>{x}</li>)}</ul></section>
  </div>
  <div class="prose"><Content /></div>
  <div class="actions">
    {item.data.shopeeUrl && <a href={item.data.shopeeUrl} target="_blank" rel="noopener">Xem trên Shopee ↗</a>}
    {item.data.tiktokUrl && <a href={item.data.tiktokUrl} target="_blank" rel="noopener">Xem trên TikTok Shop ↗</a>}
    <a href="https://zalo.me/0385651091">Hỏi ACHI qua Zalo ↗</a>
  </div>
</article>
</BaseLayout>
<style>
.review{max-width:820px;margin:auto;padding:55px 24px 90px;font-family:'Be Vietnam Pro',Arial,sans-serif;color:#151515}
.review>a{color:#315a78;text-decoration:none;font-size:12px}.kicker{margin-top:55px;color:#315a78;font-size:11px;letter-spacing:2px}
h1{font-family:Oswald,sans-serif;font-size:clamp(38px,6vw,62px);line-height:1.1;text-transform:uppercase}
.lead{font-size:17px;line-height:1.8;color:#666}.cover{width:100%;max-height:560px;object-fit:cover;margin:32px 0}
.columns{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:24px 0}.columns section{background:#f5f5f3;padding:20px}
.columns h2,.prose h2{font-family:Oswald,sans-serif;text-transform:uppercase}.columns li{font-size:13px;line-height:1.8;margin:8px 0}
.prose{font-size:15px;line-height:1.95;color:#333}.prose h2{font-size:28px;margin-top:38px}.prose a{color:#315a78}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:40px}.actions a{background:#111;color:#fff;padding:14px 18px;text-decoration:none;font-size:11px;font-weight:700}
@media(max-width:560px){.columns{grid-template-columns:1fr}}
</style>
