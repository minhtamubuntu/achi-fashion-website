---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const reviews = (await getCollection('reviews', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Review sản phẩm | ACHI FASHION" description="Đánh giá, trải nghiệm và hướng dẫn chọn sản phẩm thời trang.">
<main class="listing">
  <a class="back" href="/">← ACHI FASHION</a><p class="kicker">PRODUCT NOTES</p><h1>Review sản phẩm</h1>
  <p class="intro">Thông tin, trải nghiệm, ưu nhược điểm và lưu ý trước khi chọn mua.</p>
  <div class="cards">{reviews.map(item => <article class="card">
    {item.data.cover && <img src={item.data.cover} alt={item.data.productName} loading="lazy" />}
    <small>{item.data.pubDate.toLocaleDateString('vi-VN')}</small>
    <h2><a href={`/review/${item.id}/`}>{item.data.title}</a></h2><p>{item.data.description}</p>
    <a class="read" href={`/review/${item.id}/`}>Xem đánh giá ↗</a>
  </article>)}</div>
</main>
</BaseLayout>
<style>
.listing{max-width:1100px;margin:auto;padding:55px 24px 90px;font-family:'Be Vietnam Pro',Arial,sans-serif;color:#111}
.back{font-size:12px;color:#315a78;text-decoration:none}.kicker{margin-top:55px;color:#315a78;letter-spacing:3px;font-size:11px}
h1{font-family:Oswald,sans-serif;font-size:clamp(42px,7vw,72px);text-transform:uppercase;margin:12px 0}
.intro{color:#666;line-height:1.8}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:42px}
.card{border-top:1px solid #ddd;padding-top:16px}.card img{width:100%;aspect-ratio:4/3;object-fit:cover;margin-bottom:16px}
.card small{color:#777;font-size:10px}.card h2{font-size:19px;line-height:1.45}.card a{color:inherit;text-decoration:none}
.card p{color:#666;font-size:13px;line-height:1.8}.read{display:inline-block;margin-top:10px;border-bottom:1px solid;padding-bottom:5px;font-size:11px;font-weight:700}
@media(max-width:700px){.cards{grid-template-columns:1fr 1fr}}@media(max-width:480px){.cards{grid-template-columns:1fr}}
</style>
