---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Blog thời trang | ACHI FASHION" description="Góc chia sẻ xu hướng, kiến thức denim và gợi ý phối đồ từ ACHI FASHION.">
<main class="listing">
  <a class="back" href="/">← ACHI FASHION</a>
  <p class="kicker">ACHI JOURNAL</p><h1>Blog & Góc phong cách</h1>
  <p class="intro">Xu hướng, kiến thức denim và những gợi ý phối đồ dễ ứng dụng.</p>
  <div class="cards">
    {posts.map(post => <article class="card">
      {post.data.cover && <img src={post.data.cover} alt={post.data.title} loading="lazy" />}
      <small>{post.data.category} · {post.data.pubDate.toLocaleDateString('vi-VN')}</small>
      <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
      <p>{post.data.description}</p><a class="read" href={`/blog/${post.id}/`}>Đọc bài viết ↗</a>
    </article>)}
  </div>
</main>
</BaseLayout>
<style>
.listing{max-width:1100px;margin:0 auto;padding:55px 24px 90px;color:#111;font-family:'Be Vietnam Pro',Arial,sans-serif}
.back{font-size:12px;text-decoration:none;color:#315a78}.kicker{margin-top:55px;color:#315a78;letter-spacing:3px;font-size:11px;font-weight:700}
h1{font-family:Oswald,sans-serif;font-size:clamp(42px,7vw,72px);text-transform:uppercase;margin:12px 0}
.intro{color:#666;line-height:1.8}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:42px}
.card{border-top:1px solid #ddd;padding-top:16px}.card img{width:100%;aspect-ratio:4/3;object-fit:cover;margin-bottom:16px}
.card small{color:#777;font-size:10px}.card h2{font-size:19px;line-height:1.45}.card a{color:inherit;text-decoration:none}.card p{color:#666;font-size:13px;line-height:1.8}.read{display:inline-block;margin-top:10px;border-bottom:1px solid;padding-bottom:5px;font-size:11px;font-weight:700}
@media(max-width:700px){.cards{grid-template-columns:1fr 1fr}}@media(max-width:480px){.cards{grid-template-columns:1fr}}
</style>
