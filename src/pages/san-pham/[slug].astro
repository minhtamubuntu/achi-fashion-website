---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';

export function getStaticPaths() {
  return products
    .filter((product) => product.slug)
    .map((product) => ({
      params: { slug: product.slug },
      props: { product }
    }));
}

const { product } = Astro.props;

const formatPrice = (price) =>
  price !== null && price !== undefined
    ? `${Number(price).toLocaleString('vi-VN')}đ`
    : '';

const hasListPrice =
  product.listPrice !== null &&
  product.listPrice !== undefined;

const hasMessengerPrice =
  product.messengerPrice !== null &&
  product.messengerPrice !== undefined;

const messengerUrl =
  product.links?.messenger || 'https://m.me/aChi.Jeans';

const shopeeUrl =
  product.links?.shopee || 'https://shopee.vn/achi.jeans.shop';

const mainImage = product.images?.front || '/assets/hero.webp';

const imageList = [
  mainImage,
  product.images?.back,
  ...(product.images?.model || [])
].filter(Boolean);
---

<BaseLayout
  title={`${product.name} | ACHI FASHION`}
  description={product.description || `Khám phá ${product.name} tại ACHI FASHION.`}
>
  <main class="product-detail">
    <div class="breadcrumb">
      <a href="/">Trang chủ</a>
      <span>/</span>
      <a href="/collections/">Bộ sưu tập</a>
      <span>/</span>
      <span>{product.name}</span>
    </div>

    <section class="product-main">
      <div class="gallery" data-product-gallery>
        <div class="main-image">
          <img
            class="main-image-element"
            src={mainImage}
            alt={product.name}
          />
        </div>

        {imageList.length > 1 && (
          <div class="thumbnail-list" aria-label="Ảnh sản phẩm">
            {imageList.map((image, index) => (
              <button
                class:list={['thumbnail-button', { active: index === 0 }]}
                type="button"
                data-gallery-image={image}
                data-gallery-alt={`${product.name} - hình ${index + 1}`}
                aria-label={`Xem hình sản phẩm ${index + 1}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <img
                  src={image}
                  alt={`${product.name} - hình thu nhỏ ${index + 1}`}
                  loading="lazy"
                />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="product-summary">
        <div class="eyebrow">ACHI FASHION · DENIM COLLECTION</div>

        <h1>{product.name}</h1>

        <div class="product-code">
          MÃ SẢN PHẨM: {product.code || 'Đang cập nhật'}
        </div>

        <div class="price-area">
          {hasListPrice && (
            <div class="list-price">
              Giá niêm yết:
              <span>{formatPrice(product.listPrice)}</span>
            </div>
          )}

          {hasMessengerPrice ? (
            <div class="messenger-price">
              {hasListPrice ? 'Giá ưu đãi Messenger' : 'Giá Messenger'}
              <strong>{formatPrice(product.messengerPrice)}</strong>
            </div>
          ) : (
            <div class="price-pending">Giá bán: Đang cập nhật</div>
          )}
        </div>

        <div class="divider"></div>

        <div class="attributes">
          <div>
            <span>Giới tính</span>
            <strong>{product.gender || 'Đang cập nhật'}</strong>
          </div>
          <div>
            <span>Màu sắc</span>
            <strong>{product.color || 'Đang cập nhật'}</strong>
          </div>
          <div>
            <span>Kiểu dáng</span>
            <strong>{product.fit || 'Đang cập nhật'}</strong>
          </div>
          <div>
            <span>Chất liệu</span>
            <strong>{product.material || 'Đang cập nhật'}</strong>
          </div>
        </div>

        <div class="size-note">
          <strong>THÔNG TIN KÍCH THƯỚC</strong>
          {product.sizes?.length ? (
            <p>Kích thước hiện có: {product.sizes.join(', ')}</p>
          ) : (
            <p>
              Bảng size và thông số chi tiết đang được ACHI FASHION cập nhật.
              Vui lòng liên hệ để được tư vấn lựa chọn size phù hợp.
            </p>
          )}
        </div>

        <div class="purchase">
          <a
            class="messenger"
            href={messengerUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            NHẮN TIN CHO ACHI
          </a>

          <a
            class="shopee"
            href={shopeeUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            XEM GIAN HÀNG SHOPEE ↗
          </a>
        </div>

        <p class="support-note">
          ACHI FASHION · Hỗ trợ tư vấn sản phẩm và chọn size.
        </p>
      </div>
    </section>

    <section class="description">
      <div class="eyebrow">PRODUCT INFORMATION</div>
      <h2>THÔNG TIN SẢN PHẨM</h2>

      {product.description ? (
        <p>{product.description}</p>
      ) : (
        <p>
          Thông tin chi tiết về sản phẩm sẽ được ACHI FASHION cập nhật
          theo dữ liệu chính thức.
        </p>
      )}

      {product.material && <p>Chất liệu: {product.material}</p>}
    </section>

    <div class="back-link">
      <a href="/collections/">← QUAY LẠI BỘ SƯU TẬP</a>
    </div>
  </main>

  <script>
    document.querySelectorAll('[data-product-gallery]').forEach((gallery) => {
      const mainImage = gallery.querySelector('.main-image-element');
      const thumbnails = gallery.querySelectorAll('.thumbnail-button');

      thumbnails.forEach((thumbnail) => {
        thumbnail.addEventListener('click', () => {
          const nextImage = thumbnail.getAttribute('data-gallery-image');
          const nextAlt = thumbnail.getAttribute('data-gallery-alt') || '';

          if (!mainImage || !nextImage) return;

          mainImage.src = nextImage;
          mainImage.alt = nextAlt;

          thumbnails.forEach((item) => {
            item.classList.remove('active');
            item.setAttribute('aria-pressed', 'false');
          });

          thumbnail.classList.add('active');
          thumbnail.setAttribute('aria-pressed', 'true');
        });
      });
    });
  </script>

  <style>
    .product-detail {
      max-width: 1180px;
      margin: auto;
      padding: 35px 25px 80px;
      color: #171717;
      font-family: 'Be Vietnam Pro', Arial, sans-serif;
    }

    .breadcrumb {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 35px;
      color: #888;
      font-size: 11px;
    }

    .breadcrumb a {
      color: #555;
      text-decoration: none;
    }

    .product-main {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 55px;
      align-items: start;
    }

    .main-image {
      background: #f3f3f3;
      overflow: hidden;
    }

    .main-image img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    .thumbnail-list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin-top: 12px;
    }

    .thumbnail-button {
      display: block;
      padding: 0;
      border: 1px solid #e5e5e5;
      background: #f3f3f3;
      overflow: hidden;
      cursor: pointer;
      opacity: 0.78;
      transition: border-color 0.2s ease, opacity 0.2s ease;
    }

    .thumbnail-button:hover,
    .thumbnail-button.active {
      border: 2px solid #41647e;
      opacity: 1;
    }

    .thumbnail-button img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: cover;
    }

    .thumbnail-button:focus-visible {
      outline: 2px solid #41647e;
      outline-offset: 3px;
    }

    .eyebrow {
      color: #41647e;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 2px;
    }

    .product-summary h1 {
      font-family: Oswald, sans-serif;
      font-size: clamp(30px, 4vw, 43px);
      line-height: 1.2;
      font-weight: 600;
      margin: 15px 0;
    }

    .product-code {
      color: #888;
      font-size: 11px;
      letter-spacing: 1px;
    }

    .price-area {
      margin: 25px 0;
    }

    .list-price {
      color: #888;
      font-size: 12px;
      margin-bottom: 8px;
    }

    .list-price span {
      text-decoration: line-through;
      margin-left: 5px;
    }

    .messenger-price {
      color: #41647e;
      font-size: 12px;
      font-weight: 700;
    }

    .messenger-price strong {
      display: block;
      color: #171717;
      font-size: 25px;
      margin-top: 5px;
    }

    .price-pending {
      font-size: 20px;
      font-weight: 800;
    }

    .divider {
      height: 1px;
      background: #e5e5e5;
      margin: 22px 0;
    }

    .attributes {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px 15px;
    }

    .attributes div {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .attributes span {
      color: #888;
      font-size: 11px;
    }

    .attributes strong {
      font-size: 13px;
    }

    .size-note {
      margin-top: 30px;
      padding: 20px;
      background: #f5f6f6;
    }

    .size-note strong {
      font-size: 11px;
      letter-spacing: 1px;
    }

    .size-note p {
      color: #666;
      font-size: 12px;
      line-height: 1.8;
      margin-bottom: 0;
    }

    .purchase {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 25px;
    }

    .purchase a {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 48px;
      padding: 10px;
      color: white;
      text-decoration: none;
      text-align: center;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.5px;
    }

    .messenger {
      background: #41647e;
    }

    .shopee {
      background: #111;
    }

    .support-note {
      color: #888;
      font-size: 10px;
      margin-top: 15px;
    }

    .description {
      max-width: 780px;
      margin-top: 80px;
      padding-top: 35px;
      border-top: 1px solid #ddd;
    }

    .description h2 {
      font-family: Oswald, sans-serif;
      font-size: 30px;
      margin: 12px 0 20px;
    }

    .description p {
      color: #666;
      font-size: 13px;
      line-height: 2;
    }

    .back-link {
      margin-top: 45px;
    }

    .back-link a {
      color: #222;
      font-size: 11px;
      font-weight: 800;
      text-decoration: none;
    }

    @media (max-width: 760px) {
      .product-detail {
        padding: 25px 16px 55px;
      }

      .product-main {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .product-summary h1 {
        font-size: 32px;
      }

      .description {
        margin-top: 55px;
      }
    }

    @media (max-width: 380px) {
      .purchase {
        grid-template-columns: 1fr;
      }

      .thumbnail-list {
        gap: 6px;
      }
    }
  </style>
</BaseLayout>
